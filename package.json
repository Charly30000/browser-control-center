{
  "name": "browser-control-center",
  "displayName": "Browser Control Center",
  "description": "Panel de control para testing manual asistido y automatización web desde VS Code.",
  "version": "0.4.0",
  "publisher": "Leviax",
  "license": "Apache-2.0",
  "icon": "resources/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Charly30000/browser-control-center.git"
  },
  "homepage": "https://github.com/Charly30000/browser-control-center#readme",
  "bugs": {
    "url": "https://github.com/Charly30000/browser-control-center/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "browser",
    "testing",
    "web",
    "automation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:browserControl.sidebar",
    "onCommand:browserControl.openManual",
    "onCommand:browserControl.openFormulas",
    "onCommand:browserControl.openArrays",
    "onCommand:browserControl.openAutomations",
    "onCommand:browserControl.openAiDocumentation",
    "onCommand:browserControl.manageBrowser"
  ],
  "contributes": {
    "commands": [
      {
        "command": "browserControl.openManual",
        "title": "Browser Control: Abrir Manual"
      },
      {
        "command": "browserControl.openFormulas",
        "title": "Browser Control: Abrir Fórmulas"
      },
      {
        "command": "browserControl.openArrays",
        "title": "Browser Control: Abrir Arrays"
      },
      {
        "command": "browserControl.openAutomations",
        "title": "Browser Control: Abrir Automatizaciones"
      },
      {
        "command": "browserControl.openAiDocumentation",
        "title": "Browser Control: Abrir Documentación para IA"
      },
      {
        "command": "browserControl.manageBrowser",
        "title": "Browser Control: Gestionar navegador"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "browserControl",
          "title": "Browser Control",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "browserControl": [
        {
          "type": "webview",
          "id": "browserControl.sidebar",
          "name": "Control de navegador"
        }
      ]
    }
  },
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "verify": "npm run typecheck && npm test && npm run lint && npm run build",
    "vscode:prepublish": "npm run verify",
    "package": "vsce package"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.9"
  }
}
